{%- style -%}
  {%- if section.settings.font_family != blank -%}
    {{ section.settings.font_family | font_face: font_display: 'swap' }}
  {%- endif -%}

  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --subtext-color: {{ section.settings.subtext_color }};
    --active-card-bg: {{ section.settings.active_card_bg }};
    --dull-card-bg: {{ section.settings.dull_card_bg }};
    --active-text-color: {{ section.settings.active_text_color }};
    --dull-text-color: {{ section.settings.dull_text_color }};
    --star-color: {{ section.settings.star_color }};
    --star-bg-color: {{ section.settings.star_bg_color }};
    --star-empty-bg: {{ section.settings.star_empty_bg | default: '#dbdbdb' }};
    --card-radius: {{ section.settings.card_border_radius }}px;
    --btn-bg: {{ section.settings.btn_bg }};
    --btn-text: {{ section.settings.btn_text }};
    --btn-hover-bg: {{ section.settings.btn_hover_bg }};
    --nav-btn-bg: {{ section.settings.nav_btn_bg }};
    --nav-btn-text: {{ section.settings.nav_btn_text }};
    --pt: {{ section.settings.padding_top }}px;
    --pb: {{ section.settings.padding_bottom }}px;

    /* Font Family & Typography Variables */
    --section-font: {% if section.settings.custom_font_family != 'inherit' %}{{ section.settings.custom_font_family }}{% else %}{{ section.settings.font_family.family | default: 'inherit' }}, {{ section.settings.font_family.fallback_families | default: 'sans-serif' }}{% endif %};
    --heading-size: {{ section.settings.heading_size }}px;
    --heading-style: {{ section.settings.heading_style | default: 'normal' }};
    --heading-decoration: {{ section.settings.heading_decoration | default: 'none' }};
    --card-title-size: {{ section.settings.card_title_size }}px;
    --card-title-style: {{ section.settings.card_title_style | default: 'normal' }};
    --card-title-decoration: {{ section.settings.card_title_decoration | default: 'none' }};
    --card-body-size: {{ section.settings.card_body_size }}px;
    --card-body-style: {{ section.settings.card_body_style | default: 'normal' }};
    --card-body-decoration: {{ section.settings.card_body_decoration | default: 'none' }};
  }

  .tc-section-{{ section.id }} {
    background: {{ section.settings.bg_gradient | default: section.settings.bg_color }};
    padding-top: var(--pt);
    padding-bottom: var(--pb);
    width: 100%;
    box-sizing: border-box;
    font-family: var(--section-font);
    text-align: center;
    overflow-x: hidden;
  }

  .tc-container-{{ section.id }} {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Header Section */
  .tc-heading-{{ section.id }} {
    font-size: var(--heading-size);
    font-style: var(--heading-style);
    text-decoration: var(--heading-decoration);
    font-weight: 800;
    color: var(--heading-color);
    margin: 0 0 16px 0;
    line-height: 1.25;
  }

  .tc-rating-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    margin-bottom: 36px;
  }

  .tc-rating-top {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 700;
    color: var(--heading-color);
  }

  .tc-stars-row {
    display: flex;
    gap: 3px;
  }

  .tc-star-box {
    background-color: var(--star-bg-color);
    color: var(--star-color);
    font-size: 11px;
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
    overflow: hidden;
  }

  .tc-star-box.tc-star-empty {
    background-color: var(--star-empty-bg);
  }

  .tc-rating-sub {
    font-size: 14px;
    color: var(--subtext-color);
  }

  .tc-rating-sub strong {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Carousel Track Wrapper */
  .tc-carousel-wrapper {
    position: relative;
    width: 100%;
    max-width: 1300px;
    margin: 0 auto 36px auto;
    padding: 10px 0;
  }

  .tc-carousel-viewport {
    width: 100%;
    overflow: hidden;
    padding: 20px 0;
    cursor: grab;
    touch-action: pan-y;
  }

  .tc-carousel-viewport:active {
    cursor: grabbing;
  }

  .tc-carousel-track {
    display: flex;
    align-items: center;
    will-change: transform;
  }

  /* Testimonial Card Styling */
  .tc-card {
    flex: 0 0 280px;
    max-width: 280px;
    margin: 0 12px;
    background-color: var(--dull-card-bg);
    border-radius: var(--card-radius);
    padding: 32px 24px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    opacity: 0.65;
    transform: scale(0.94);
    transition: all 0.45s cubic-bezier(0.25, 1, 0.5, 1);
    {% if section.settings.enable_card_shadow %}
      box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    {% else %}
      box-shadow: none;
    {% endif %}
    cursor: pointer;
    user-select: none;
  }

  @media screen and (min-width: 768px) {
    .tc-card {
      flex: 0 0 310px;
      max-width: 310px;
    }
  }

  /* PROMINENT CENTER CARD */
  .tc-card.active-center {
    background-color: var(--active-card-bg);
    opacity: 1;
    transform: scale(1.06);
    {% if section.settings.enable_card_shadow %}
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.08);
    {% else %}
      box-shadow: none;
    {% endif %}
    z-index: 3;
  }

  .tc-card-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 18px;
  }

  .tc-card-title {
    font-size: var(--card-title-size);
    font-style: var(--card-title-style);
    text-decoration: var(--card-title-decoration);
    font-weight: 700;
    color: var(--dull-text-color);
    margin: 0 0 14px 0;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .tc-card.active-center .tc-card-title {
    color: var(--active-text-color);
  }

  .tc-card-body {
    font-size: var(--card-body-size);
    font-style: var(--card-body-style);
    text-decoration: var(--card-body-decoration);
    line-height: 1.55;
    color: var(--dull-text-color);
    margin: 0 0 24px 0;
    flex-grow: 1;
    transition: color 0.3s ease;
  }

  .tc-card.active-center .tc-card-body {
    color: var(--active-text-color);
  }

  .tc-card-author {
    font-size: 13px;
    color: var(--dull-text-color);
    opacity: 0.8;
    font-weight: 500;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .tc-card.active-center .tc-card-author {
    color: var(--active-text-color);
    opacity: 0.9;
    font-weight: 600;
  }

  /* Navigation Buttons */
  .tc-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--nav-btn-bg);
    color: var(--nav-btn-text);
    border: none;
    {% if section.settings.enable_card_shadow %}
      box-shadow: 0 4px 14px rgba(0,0,0,0.12);
    {% else %}
      box-shadow: none;
    {% endif %}
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .tc-nav-btn:hover {
    transform: translateY(-50%) scale(1.08);
    {% if section.settings.enable_card_shadow %}
      box-shadow: 0 6px 18px rgba(0,0,0,0.16);
    {% endif %}
  }

  .tc-nav-prev {
    left: 10px;
  }

  .tc-nav-next {
    right: 10px;
  }

  @media screen and (min-width: 992px) {
    .tc-nav-prev {
      left: 18%;
    }
    .tc-nav-next {
      right: 18%;
    }
  }

  /* Bottom View All Button */
  .tc-view-all-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    padding: 14px 40px;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.3s ease;
    {% if section.settings.enable_card_shadow %}
      box-shadow: 0 4px 14px rgba(0,0,0,0.1);
    {% endif %}
  }

  .tc-view-all-btn:hover {
    background-color: var(--btn-hover-bg);
    transform: translateY(-2px);
    {% if section.settings.enable_card_shadow %}
      box-shadow: 0 6px 20px rgba(0,0,0,0.16);
    {% endif %}
  }

  /* Floating Sticky Video Widget Styling */
  .tc-floating-video-wrap {
    position: fixed;
    bottom: 20px;
    left: 20px;
    z-index: 9999;
    width: 110px;
    height: 160px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
    cursor: pointer;
    background-color: #000000;
  }

  .tc-floating-video-wrap.pos-bottom-right {
    left: auto;
    right: 20px;
  }

  .tc-floating-video-wrap.is-expanded {
    width: 300px;
    height: 480px;
    max-width: calc(100vw - 40px);
    max-height: calc(100vh - 40px);
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .tc-floating-video-wrap.is-closed {
    display: none !important;
  }

  .tc-floating-video-el {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .tc-floating-close-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.65);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
    z-index: 10;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .tc-floating-close-btn:hover {
    background: rgba(0, 0, 0, 0.9);
    transform: scale(1.1);
  }

  .tc-floating-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20px 16px;
    background: linear-gradient(0deg, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    z-index: 5;
  }

  .tc-floating-video-wrap.is-expanded .tc-floating-overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .tc-floating-title {
    color: #ffffff;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin: 0;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .tc-floating-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 12px 20px;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 30px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(0,0,0,0.2);
    cursor: pointer;
  }

  .tc-floating-btn:hover {
    background-color: var(--btn-hover-bg);
    transform: translateY(-2px);
  }

  .tc-floating-btn svg, .tc-floating-btn img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }
{%- endstyle -%}

<div class="tc-section-{{ section.id }}" id="shopify-section-{{ section.id }}-content">
  <div class="tc-container-{{ section.id }}">

    {%- if section.settings.heading != blank -%}
      <h2 class="tc-heading-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.show_rating_badge -%}
      <div class="tc-rating-badge">
        <div class="tc-rating-top">
          <span>{{ section.settings.rating_prefix }} <strong>{{ section.settings.rating_score }}</strong></span>
          <div class="tc-stars-row">
            {%- assign badge_r = section.settings.badge_rating | default: 4.7 | plus: 0.0 -%}
            {%- for i in (1..5) -%}
              {%- assign star_min = i | minus: 1.0 -%}
              {%- if badge_r >= i -%}
                <span class="tc-star-box tc-star-full">★</span>
              {%- elsif badge_r <= star_min -%}
                <span class="tc-star-box tc-star-empty">★</span>
              {%- else -%}
                {%- assign fraction = badge_r | minus: star_min -%}
                {%- assign fill_pct = fraction | times: 100 | round -%}
                <span class="tc-star-box tc-star-partial" style="background: linear-gradient(90deg, var(--star-bg-color) {{ fill_pct }}%, var(--star-empty-bg) {{ fill_pct }}%);">★</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- if section.settings.rating_subtext != blank -%}
          <div class="tc-rating-sub">
            {{ section.settings.rating_subtext }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>

  <!-- Testimonials Carousel Slider -->
  <div class="tc-carousel-wrapper">
    <button type="button" class="tc-nav-btn tc-nav-prev" aria-label="Previous Review">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>

    <button type="button" class="tc-nav-btn tc-nav-next" aria-label="Next Review">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
    </button>

    <div class="tc-carousel-viewport">
      <div class="tc-carousel-track" id="tcTrack-{{ section.id }}">

        {%- for block in section.blocks -%}
          <div class="tc-card" data-block-id="{{ block.id }}" data-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="tc-card-stars">
              {%- assign card_r = block.settings.rating | default: 5 | plus: 0.0 -%}
              {%- for i in (1..5) -%}
                {%- assign star_min = i | minus: 1.0 -%}
                {%- if card_r >= i -%}
                  <span class="tc-star-box tc-star-full">★</span>
                {%- elsif card_r <= star_min -%}
                  <span class="tc-star-box tc-star-empty">★</span>
                {%- else -%}
                  {%- assign fraction = card_r | minus: star_min -%}
                  {%- assign fill_pct = fraction | times: 100 | round -%}
                  <span class="tc-star-box tc-star-partial" style="background: linear-gradient(90deg, var(--star-bg-color) {{ fill_pct }}%, var(--star-empty-bg) {{ fill_pct }}%);">★</span>
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if block.settings.title != blank -%}
              <h3 class="tc-card-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.review_text != blank -%}
              <p class="tc-card-body">{{ block.settings.review_text }}</p>
            {%- endif -%}

            {%- if block.settings.author_name != blank -%}
              <div class="tc-card-author">
                {{ block.settings.author_name }}{% if block.settings.review_date != blank %} - {{ block.settings.review_date }}{% endif %}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}

      </div>
    </div>
  </div>

  {%- if section.settings.button_text != blank -%}
    <div class="tc-container-{{ section.id }}">
      <a href="{{ section.settings.button_link | default: '#' }}" class="tc-view-all-btn">
        {{ section.settings.button_text }}
      </a>
    </div>
  {%- endif -%}

  <!-- Floating Sticky Video Widget -->
  {%- if section.settings.enable_floating_video -%}
    <div class="tc-floating-video-wrap pos-{{ section.settings.floating_video_position | default: 'bottom-left' | replace: '_', '-' }}" id="tcFloatingVideo-{{ section.id }}">
      <button type="button" class="tc-floating-close-btn" aria-label="Close Video">✕</button>

      {%- if section.settings.floating_video_shopify != blank -%}
        {{ section.settings.floating_video_shopify | video_tag: autoplay: section.settings.floating_video_autoplay, loop: section.settings.floating_video_loop, muted: section.settings.floating_video_muted, playsinline: true, controls: section.settings.floating_video_controls, class: 'tc-floating-video-el', poster: section.settings.floating_video_poster }}
      {%- else -%}
        <video class="tc-floating-video-el"
          {% if section.settings.floating_video_autoplay %}autoplay{% endif %}
          {% if section.settings.floating_video_loop %}loop{% endif %}
          {% if section.settings.floating_video_muted %}muted{% endif %}
          {% if section.settings.floating_video_controls %}controls{% endif %}
          playsinline
          {% if section.settings.floating_video_poster != blank %}poster="{{ section.settings.floating_video_poster | image_url }}"{% endif %}>
          <source src="{{ section.settings.floating_video_url | default: 'https://assets.mixkit.co/videos/preview/mixkit-woman-applying-face-cream-41584-large.mp4' }}" type="video/mp4">
        </video>
      {%- endif -%}

      <div class="tc-floating-overlay">
        {%- if section.settings.floating_video_title != blank -%}
          <h4 class="tc-floating-title">{{ section.settings.floating_video_title }}</h4>
        {%- endif -%}
        {%- if section.settings.floating_video_btn_text != blank -%}
          <a href="{{ section.settings.floating_video_btn_link | default: '#shopify-section-' | append: section.id }}" class="tc-floating-btn" id="tcFloatingBtn-{{ section.id }}">
            <span>{{ section.settings.floating_video_btn_text }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (function() {
    function initTCCarousel(sectionId) {
      const sectionContainer = document.getElementById('shopify-section-' + sectionId + '-content');
      if (!sectionContainer) return;

      const track = sectionContainer.querySelector('#tcTrack-' + sectionId);
      if (!track) return;
      const viewport = track.parentElement;

      const originalCards = Array.from(track.querySelectorAll('.tc-card'));
      const N = originalCards.length;
      if (N === 0) return;

      const prevBtn = sectionContainer.querySelector('.tc-nav-prev');
      const nextBtn = sectionContainer.querySelector('.tc-nav-next');
      const isAutoplayEnabled = {{ section.settings.enable_autoplay | json }};
      const autoplayDuration = {{ section.settings.autoplay_speed | default: 5 }} * 1000;

      let allCards = originalCards;
      let currentIndex = Math.floor(N / 2);
      let autoplayTimer = null;

      if (N > 1) {
        // Seamless Infinite Circular Loop Setup (Clone Cards)
        originalCards.forEach(card => {
          const clone = card.cloneNode(true);
          clone.classList.add('is-clone');
          track.appendChild(clone);
        });

        originalCards.slice().reverse().forEach(card => {
          const clone = card.cloneNode(true);
          clone.classList.add('is-clone');
          track.insertBefore(clone, track.firstChild);
        });

        allCards = Array.from(track.querySelectorAll('.tc-card'));
        currentIndex = N + Math.floor(N / 2);

        track.addEventListener('transitionend', function() {
          if (currentIndex >= 2 * N) {
            currentIndex = currentIndex - N;
            updateCarousel(false);
          } else if (currentIndex < N) {
            currentIndex = currentIndex + N;
            updateCarousel(false);
          }
        });
      }

      function updateCarousel(animate = true) {
        if (allCards.length === 0) return;
        const viewportWidth = viewport.offsetWidth;
        const activeCard = allCards[currentIndex];
        if (!activeCard) return;

        if (animate) {
          track.style.transition = 'transform 0.45s cubic-bezier(0.25, 1, 0.5, 1)';
        } else {
          track.style.transition = 'none';
        }

        const cardOffsetLeft = activeCard.offsetLeft;
        const cardWidth = activeCard.offsetWidth;

        // Calculate translation offset to center active card in viewport
        const translateX = (viewportWidth / 2) - (cardOffsetLeft + (cardWidth / 2));
        track.style.transform = `translateX(${translateX}px)`;

        // Highlight active center card
        allCards.forEach((card, idx) => {
          card.classList.toggle('active-center', idx === currentIndex);
        });

        startAutoplay();
      }

      function startAutoplay() {
        if (autoplayTimer) clearTimeout(autoplayTimer);
        if (isAutoplayEnabled && N > 1) {
          autoplayTimer = setTimeout(() => {
            if (currentIndex >= 2 * N) {
              currentIndex = currentIndex - N;
              updateCarousel(false);
              track.offsetHeight; // Force reflow
            }
            currentIndex++;
            updateCarousel(true);
          }, autoplayDuration);
        }
      }

      // Touch & Mouse Drag / Swipe Handlers
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      function onDragStart(e) {
        if (N <= 1) return;
        isDragging = true;
        startX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
        currentX = startX;
        if (autoplayTimer) clearTimeout(autoplayTimer);
      }

      function onDragMove(e) {
        if (!isDragging) return;
        currentX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
      }

      function onDragEnd() {
        if (!isDragging) return;
        isDragging = false;
        const diffX = currentX - startX;

        if (Math.abs(diffX) > 35) {
          if (diffX < 0) {
            // Dragged Left -> Next
            if (currentIndex >= 2 * N) {
              currentIndex = currentIndex - N;
              updateCarousel(false);
              track.offsetHeight;
            }
            currentIndex++;
          } else {
            // Dragged Right -> Prev
            if (currentIndex < N) {
              currentIndex = currentIndex + N;
              updateCarousel(false);
              track.offsetHeight;
            }
            currentIndex--;
          }
          updateCarousel(true);
        } else {
          updateCarousel(true);
        }
        startX = 0;
        currentX = 0;
      }

      viewport.addEventListener('touchstart', onDragStart, { passive: true });
      viewport.addEventListener('touchmove', onDragMove, { passive: true });
      viewport.addEventListener('touchend', onDragEnd);

      viewport.addEventListener('mousedown', onDragStart);
      window.addEventListener('mousemove', onDragMove);
      window.addEventListener('mouseup', onDragEnd);

      if (prevBtn && N > 1) {
        prevBtn.addEventListener('click', function(e) {
          e.preventDefault();
          if (currentIndex < N) {
            currentIndex = currentIndex + N;
            updateCarousel(false);
            track.offsetHeight;
          }
          currentIndex--;
          updateCarousel(true);
        });
      }

      if (nextBtn && N > 1) {
        nextBtn.addEventListener('click', function(e) {
          e.preventDefault();
          if (currentIndex >= 2 * N) {
            currentIndex = currentIndex - N;
            updateCarousel(false);
            track.offsetHeight;
          }
          currentIndex++;
          updateCarousel(true);
        });
      }

      allCards.forEach((card, idx) => {
        card.addEventListener('click', function() {
          if (currentIndex !== idx) {
            currentIndex = idx;
            updateCarousel(true);
          }
        });
      });

      // Floating Sticky Video Click & Expand Logic
      const videoWrap = sectionContainer.querySelector('#tcFloatingVideo-' + sectionId);
      if (videoWrap) {
        const videoEl = videoWrap.querySelector('video');

        videoWrap.addEventListener('click', function(e) {
          if (e.target.closest('.tc-floating-close-btn')) {
            e.stopPropagation();
            videoWrap.classList.add('is-closed');
            if (videoEl) videoEl.pause();
            return;
          }

          const ctaBtn = e.target.closest('.tc-floating-btn');
          if (ctaBtn) {
            e.stopPropagation();
            const targetHref = ctaBtn.getAttribute('href');
            if (!targetHref || targetHref === '#' || targetHref.startsWith('#shopify-section-')) {
              e.preventDefault();
              sectionContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            return;
          }

          const isExpanded = videoWrap.classList.toggle('is-expanded');
          if (videoEl) {
            if (isExpanded) {
              videoEl.muted = false;
              videoEl.play().catch(() => {});
            } else {
              {% if section.settings.floating_video_muted %}
                videoEl.muted = true;
              {% endif %}
            }
          }
        });
      }

      window.addEventListener('resize', function() {
        updateCarousel(false);
      });

      setTimeout(function() {
        updateCarousel(false);
      }, 60);

      // Shopify Admin Live Editor Preview Sync
      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:block:select', function(event) {
          if (event.detail.sectionId === sectionId) {
            const selectedBlockId = event.detail.blockId;
            const realIdx = originalCards.findIndex(c => c.getAttribute('data-block-id') === event.detail.blockId);
            if (realIdx !== -1) {
              currentIndex = N + realIdx;
              updateCarousel(true);
            }
          }
        });
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      initTCCarousel('{{ section.id }}');
    });

    if (window.Shopify && Shopify.designMode) {
      initTCCarousel('{{ section.id }}');
    }
  })();
</script>

