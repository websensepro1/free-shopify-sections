<script>
(function () {
  'use strict';
  var SID     = '{{ section.id }}';
  var sec     = document.getElementById('cr-' + SID);
  var rack    = document.getElementById('crRack-' + SID);
  var stage   = document.getElementById('crStage-' + SID);
  if (!sec || !rack) return;

  var HOVER_MS     = {{ section.settings.hover_speed }};
  var SL_MODE      = '{{ sl_mode }}';
  var SL_AUTO_MS   = {{ sl_speed }};
  var PER_DESK     = {{ section.settings.items_desktop | default: 4 }};
  var PER_MOB      = {{ section.settings.items_mobile | default: 2 }};
  var mqDesk       = window.matchMedia('(min-width:750px)');
  var reduceMotion = window.matchMedia('(prefers-reduced-motion:reduce)').matches;
  var fineHover    = window.matchMedia('(hover:hover) and (pointer:fine)').matches;

  function ss(x){ return x*x*(3-2*x); }
  function clamp(v,a,b){ return v<a?a:v>b?b:v; }

  var items = [].slice.call(rack.querySelectorAll('.cr-item'));

  /* ── image aspect & width ── */
  function aspectOf(img){
    if(img&&img.naturalWidth>0)return img.naturalWidth/img.naturalHeight;
    var w=+img.getAttribute('width'),h=+img.getAttribute('height');
    return w>0&&h>0?w/h:null;
  }
  function setWidth(it,e){
    var g    = it.querySelector('.cr-garment');
    var hpx  = g.getBoundingClientRect().height ||
               parseFloat(getComputedStyle(rack).getPropertyValue('--cr-h'))||300;
    var si   = it.querySelector('.cr-view[data-pos="0"] img');
    var fi   = it.querySelector('.cr-view[data-pos="1"] img');
    var a0   = si?(aspectOf(si)||0.30):0.30;
    var a1   = fi?(aspectOf(fi)||0.70):0.70;
    if(slotW){ it.style.width = slotW+'px'; return; }
    it.style.width = Math.round(hpx*(a0+(a1-a0)*ss(e)))+'px';
  }
  /* ── products-per-view: equal slots, size auto-fits ── */
  var slotW = 0;
  function layoutSlots(){
    var per = mqDesk.matches ? PER_DESK : PER_MOB;
    var sw  = stage ? stage.clientWidth : 0;
    if(!per || !sw){ slotW = 0; return; }
    slotW = Math.floor(sw / per);
    var maxH = parseFloat(getComputedStyle(sec).getPropertyValue(mqDesk.matches ? '--cr-h-desk' : '--cr-h-mob')) || 400;
    /* widest view (front) must fit inside its slot */
    var amax = 0.3;
    items.forEach(function(it){
      [].forEach.call(it.querySelectorAll('.cr-view img'),function(im){ var a = aspectOf(im); if(a && a > amax) amax = a; });
    });
    var h = Math.min(maxH, Math.floor(slotW * 0.92 / amax));
    rack.style.setProperty('--cr-h', Math.max(80, h) + 'px');
  }
  var measuredOnce=false;
  function scheduleInit(){ if(measuredOnce)return;measuredOnce=true;requestAnimationFrame(function(){measuredOnce=false;initWidths();}); }
  function initWidths(){ layoutSlots(); items.forEach(function(it){var s=states.get(it);setWidth(it,s?s.t:0);}); }
  var states=new Map();
  items.forEach(function(it){states.set(it,{t:0,p:0});});
  items.forEach(function(it){
    it.querySelectorAll('img[src]').forEach(function(im){
      if(im.complete&&im.naturalWidth)scheduleInit();
      else im.addEventListener('load',scheduleInit,{once:true});
    });
  });
  scheduleInit();
  window.addEventListener('resize',scheduleInit);
  window.addEventListener('load',scheduleInit);

  /* ── swing physics ── */
  var KS=17,KD=1.55,MA=12,crDragging=false,swRaf=0,swLast=0;
  function impulse(el,v){ if(reduceMotion||!el)return;var s=el._sw||(el._sw={a:0,v:0});s.v+=v;if(!swRaf){swLast=0;swRaf=requestAnimationFrame(swLoop);} }
  function swLoop(ts){ var dt=swLast?Math.min(.05,(ts-swLast)/1e3):1/60;swLast=ts;var live=false;
    items.forEach(function(el){var s=el._sw;if(!s)return;
      if(Math.abs(s.a)<.03&&Math.abs(s.v)<.08){if(s.a||s.v){s.a=s.v=0;el.style.setProperty('--cr-sw','0deg');}return;}
      for(var i=0;i<2;i++){s.v+=(-KS*s.a-KD*s.v)*(dt/2);s.a+=s.v*(dt/2);}
      if(s.a>MA){s.a=MA;s.v*=-.35;}if(s.a<-MA){s.a=-MA;s.v*=-.35;}
      el.style.setProperty('--cr-sw',(-s.a).toFixed(2)+'deg');live=true;
    });
    swRaf=live?requestAnimationFrame(swLoop):0;
  }
  var scY=pageYOffset||0,scT=0;
  window.addEventListener('scroll',function(){
    var now=performance.now();if(now-scT<110)return;
    var y=pageYOffset||0,dy=y-scY,dt=now-scT;scY=y;scT=now;
    if(dt>400||!dy)return;var sp=dy/dt;
    items.forEach(function(el,i){impulse(el,clamp(sp*9,-16,16)*(i%2?1:-.8));});
  },{passive:true});

  /* ── hover turn ── */
  var running=false,rafId=0,lastTs=0;
  function applyTurn(it,e){
    var sv=it.querySelector('.cr-view[data-pos="0"]');
    var fv=it.querySelector('.cr-view[data-pos="1"]');
    if(!sv||!fv)return;
    sv.style.opacity=Math.max(0,Math.min(1,(0.55-e)/.12));
    if(e<=0)sv.style.transform='none';
    else sv.style.transform='perspective(900px) rotateY('+(Math.min(1,e*2)*-86).toFixed(1)+'deg)';
    fv.style.opacity=Math.max(0,Math.min(1,(e-.44)/.12));
    fv.style.transform=e>=1?'none':'scale('+(0.92+0.08*e).toFixed(4)+')';
    it.classList.toggle('cr-live',e>.02);
    setWidth(it,e);
  }
  function animLoop(ts){
    if(!lastTs)lastTs=ts;var dt=Math.min(64,ts-lastTs);lastTs=ts;
    var k=1-Math.exp(-dt/(HOVER_MS*.3));var busy=false;
    states.forEach(function(s,it){
      var d=s.t-s.p;
      if(Math.abs(d)>.02){s.p+=d*k;busy=true;}
      else if(s.p!==s.t){s.p=s.t;busy=true;}else return;
      applyTurn(it,ss(s.p));
    });
    if(busy)rafId=requestAnimationFrame(animLoop);else{running=false;lastTs=0;rafId=0;}
  }
  function kick(){if(!running){running=true;rafId=requestAnimationFrame(animLoop);}}

  var curHover=null;
  function setHover(it){
    if(curHover===it)return;var prev=curHover;curHover=it;
    if(prev)states.get(prev).t=0;
    if(it){states.get(it).t=1;setCaption(it.dataset.name||null);}
    else setCaption(null);kick();
    if(prev){var i=items.indexOf(prev);if(items[i-1]&&items[i-1]!==it)impulse(items[i-1],12);if(items[i+1]&&items[i+1]!==it)impulse(items[i+1],-12);}
    if(it){var j=items.indexOf(it);if(items[j-1])impulse(items[j-1],-26);if(items[j+1])impulse(items[j+1],26);}
  }
  if(fineHover){
    var mX=0,mT=0;
    rack.addEventListener('mousemove',function(ev){
      if(crDragging)return;
      var x=ev.clientX,y=ev.clientY,now=performance.now();
      if(mT&&now-mT<100){var vx=(x-mX)/Math.max(1,now-mT);
        items.forEach(function(it){if(it===curHover)return;var r=it.getBoundingClientRect();
          if(y<r.top||y>r.bottom)return;var c=(r.left+r.right)/2;
          if((mX-c)*(x-c)<0)impulse(it,clamp(vx*24,-50,50));
        });
      }
      mX=x;mT=now;
      if(curHover){var cr=curHover.getBoundingClientRect();if(x>=cr.left-20&&x<=cr.right+20&&y>=cr.top-10&&y<=cr.bottom+40)return;}
      var best=null,bd=1e9;
      items.forEach(function(it){var r=it.getBoundingClientRect();
        if(y<r.top-10||y>r.bottom+40||x<r.left-2||x>r.right+2)return;
        var d=Math.abs(x-(r.left+r.right)/2);if(d<bd){bd=d;best=it;}
      });
      setHover(best||null);
    });
    rack.addEventListener('mouseleave',function(){mT=0;setHover(null);});
  }

  var capEl=document.getElementById('crCapName-'+SID);
  var capDef=capEl?capEl.textContent:'',capCur='',capTm=null;
  function setCaption(txt){
    var k=txt||'';if(!capEl||capCur===k)return;capCur=k;
    capEl.classList.add('cr-swap');clearTimeout(capTm);
    capTm=setTimeout(function(){capEl.textContent=txt||capDef;capEl.classList.remove('cr-swap');},160);
  }

  /* ══════════════════════════════════════
     SLIDER LOGIC
     ══════════════════════════════════════ */
  if(SL_MODE==='manual'||SL_MODE==='auto'){
    var prevBtn  = document.getElementById('crPrev-'+SID);
    var nextBtn  = document.getElementById('crNext-'+SID);
    var dotsWrap = document.getElementById('crDots-'+SID);
    var cur = 0, curOff = 0, autoTimer = null, hoverPause = false;
    var EASE = 'transform .9s cubic-bezier(.22,.8,.24,1)';
    rack.style.transition = EASE;
    rack.style.touchAction = 'pan-y';

    function offOf(i){ return items[i] ? items[i].offsetLeft - items[0].offsetLeft : 0; }
    function fitAlign(){
      rack.style.justifyContent = 'flex-start';
      rack.style.justifyContent = rack.scrollWidth > stage.clientWidth + 2 ? 'flex-start' : 'center';
    }
    function maxOff(){ return Math.max(0, rack.scrollWidth - stage.clientWidth); }
    function maxIdx(){
      var m = maxOff();
      for(var i=0;i<items.length;i++){ if(offOf(i) >= m - 2) return i; }
      return items.length-1;
    }
    function setX(x){ curOff = x; rack.style.transform = 'translateX(' + (-x) + 'px)'; }

    /* wardrobe sway: every garment swings, slight wave delay + randomness */
    function swayAll(dir, strength){
      if(reduceMotion || !dir) return;
      items.forEach(function(el,i){
        var d = Math.abs(i - cur) * 45;
        setTimeout(function(){ impulse(el, dir * strength * (0.75 + Math.random()*0.5)); }, d);
      });
      /* settle-back swing when the rack stops */
      setTimeout(function(){
        items.forEach(function(el){ impulse(el, -dir * strength * 0.45); });
      }, 780);
    }

    function buildDots(){
      if(!dotsWrap) return;
      dotsWrap.innerHTML = '';
      var n = maxIdx() + 1;
      if(n <= 1){ dotsWrap.style.display = 'none'; return; }
      dotsWrap.style.display = '';
      for(var i=0;i<n;i++){
        (function(idx){
          var d = document.createElement('button');
          d.type = 'button'; d.className = 'cr-dot';
          d.setAttribute('aria-label','Slide '+(idx+1));
          d.addEventListener('click',function(){ goSlide(idx); resetAuto(); });
          dotsWrap.appendChild(d);
        })(i);
      }
      updateUI();
    }
    function updateUI(){
      if(dotsWrap) [].forEach.call(dotsWrap.querySelectorAll('.cr-dot'),function(d,i){ d.classList.toggle('cr-dot-on', i===cur); });
      var mi = maxIdx();
      if(prevBtn) prevBtn.disabled = SL_MODE!=='auto' && cur<=0;
      if(nextBtn) nextBtn.disabled = SL_MODE!=='auto' && cur>=mi;
    }

    function goSlide(n, noSway){
      var mi = maxIdx();
      cur = Math.max(0, Math.min(n, mi));
      var from = curOff;
      var to = Math.min(offOf(cur), maxOff());
      rack.style.transition = EASE;
      setX(to);
      var dx = to - from;
      if(!noSway && Math.abs(dx) > 1){
        var iw = items[0] ? items[0].getBoundingClientRect().width || 80 : 80;
        swayAll(dx > 0 ? 1 : -1, clamp(Math.abs(dx)/iw * 16, 14, 38));
      }
      updateUI();
    }
    function nextSlide(){ var mi = maxIdx(); goSlide(cur >= mi ? 0 : cur + 1); }
    function prevSlide(){ var mi = maxIdx(); goSlide(cur <= 0 ? (SL_MODE==='auto' ? mi : 0) : cur - 1); }

    if(nextBtn) nextBtn.addEventListener('click',function(){ nextSlide(); resetAuto(); });
    if(prevBtn) prevBtn.addEventListener('click',function(){ prevSlide(); resetAuto(); });

    /* auto play — one product at a time, pauses on hover / drag / hidden tab */
    function startAuto(){
      clearInterval(autoTimer);
      if(SL_MODE!=='auto' || reduceMotion) return;
      autoTimer = setInterval(function(){
        if(hoverPause || crDragging || document.hidden) return;
        if(typeof curFocus!=='undefined' && curFocus) return;
        nextSlide();
      }, SL_AUTO_MS);
    }
    function resetAuto(){ startAuto(); }
    stage.addEventListener('mouseenter',function(){ hoverPause = true; });
    stage.addEventListener('mouseleave',function(){ hoverPause = false; });

    /* click-hold drag (mouse + touch) */
    var pId = null, startX = 0, startY = 0, startOff = 0, lastX = 0, lastT = 0, vel = 0, moved = false, axis = '';
    rack.addEventListener('pointerdown',function(e){
      if(e.button !== undefined && e.button !== 0) return;
      pId = e.pointerId; startX = lastX = e.clientX; startY = e.clientY;
      startOff = curOff; lastT = performance.now(); vel = 0; moved = false; axis = '';
    });
    window.addEventListener('pointermove',function(e){
      if(pId === null || e.pointerId !== pId) return;
      var dx = e.clientX - startX, dy = e.clientY - startY;
      if(!axis){
        if(Math.abs(dx) < 6 && Math.abs(dy) < 6) return;
        axis = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        if(axis === 'y'){ pId = null; return; }
        moved = true; crDragging = true;
        rack.style.transition = 'none';
        rack.classList.add('cr-grabbing');
        if(typeof setHover === 'function') setHover(null);
        try{ rack.setPointerCapture(e.pointerId); }catch(_){}
      }
      var now = performance.now(), dt = Math.max(1, now - lastT);
      vel = (e.clientX - lastX) / dt; lastX = e.clientX; lastT = now;
      var x = startOff - dx, m = maxOff();
      if(x < 0) x = x * 0.35;                 /* rubber band */
      if(x > m) x = m + (x - m) * 0.35;
      setX(x);
      /* garments lag behind the hand — slow continuous sway */
      if(!reduceMotion) items.forEach(function(el){ impulse(el, clamp(-vel * 3.2, -6, 6)); });
    });
    function endDrag(e){
      if(pId === null || (e && e.pointerId !== pId)) return;
      pId = null;
      rack.classList.remove('cr-grabbing');
      if(!moved){ return; }
      /* snap to nearest product, with a little momentum */
      var target = curOff - vel * 220, best = 0, bd = 1e9;
      for(var i=0;i<=maxIdx();i++){ var d = Math.abs(offOf(i) - target); if(d < bd){ bd = d; best = i; } }
      goSlide(best);
      setTimeout(function(){ crDragging = false; }, 60);
      resetAuto();
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
    /* swallow the click that ends a drag so popup doesn't open */
    rack.addEventListener('click',function(e){ if(moved){ e.stopPropagation(); e.preventDefault(); moved = false; } }, true);
    rack.addEventListener('dragstart',function(e){ e.preventDefault(); });

    /* keep position valid while widths change (hover / resize / image load) */
    var rT = null;
    function relayout(){ clearTimeout(rT); rT = setTimeout(function(){ fitAlign(); buildDots(); goSlide(cur, true); }, 120); }
    window.addEventListener('resize', relayout);
    window.addEventListener('load', function(){ relayout(); startAuto(); });
    fitAlign(); buildDots(); goSlide(0, true); startAuto();
  }

  /* ══════════════════════════════════════
     FOCUS VIEW
     ══════════════════════════════════════ */
  var focus  = document.getElementById('crFocus-'+SID);
  var fstage = document.getElementById('crFstage-'+SID);
  var fname  = document.getElementById('crFname-'+SID);
  var ftabs  = document.getElementById('crFtabs-'+SID);
  var fbtn   = document.getElementById('crFbtn-'+SID);
  var fcount = document.getElementById('crFcount-'+SID);
  var fprice = document.getElementById('crFprice-'+SID);
  var fopts  = document.getElementById('crFopts-'+SID);
  var fatc   = document.getElementById('crFatc-'+SID);
  var ffoot  = document.getElementById('crFfootname-'+SID);
  var closeX = document.getElementById('crClose-'+SID);
  var fprev  = document.getElementById('crFprev-'+SID);
  var fnext  = document.getElementById('crFnext-'+SID);
  var fFront = fstage?fstage.querySelector('.cr-fs-front'):null;
  var fBack  = fstage?fstage.querySelector('.cr-fs-back'):null;
  var fInd   = ftabs?ftabs.querySelector('.cr-tab-ind'):null;
  if(focus) document.body.appendChild(focus);
  function big(u){return u?u.replace(/([?&])width=\d+/,'$1width=1400'):'';}
  function moveInd(){
    if(!fInd||!ftabs)return;
    var on=ftabs.querySelector('.cr-tab.cr-tab-on');if(!on)return;
    fInd.style.width=on.offsetWidth+'px';
    fInd.style.transform='translateX('+(on.offsetLeft-4)+'px)';
  }

  var curFocus=null,curView='front',fVariants=[],fSel=[],fCur=null;
  var fatcT=fatc?fatc.querySelector('.cr-atc-txt'):null;var ATC_TXT=fatcT?fatcT.textContent:'Add to cart';
  function pad(n){return (n<10?'0':'')+n;}
  function money(c){
    try{return new Intl.NumberFormat(document.documentElement.lang||undefined,{style:'currency',currency:(window.Shopify&&Shopify.currency&&Shopify.currency.active)||'USD'}).format(c/100);}
    catch(e){return (c/100).toFixed(2);}
  }
  function esc(t){var d=document.createElement('div');d.textContent=t;return d.innerHTML;}

  function findVariant(){
    for(var i=0;i<fVariants.length;i++){
      var v=fVariants[i],ok=true;
      for(var j=0;j<fSel.length;j++){if(v.options[j]!==fSel[j]){ok=false;break;}}
      if(ok)return v;
    }
    return null;
  }
  function applyVariant(){
    fCur=findVariant();
    if(fopts)fopts.querySelectorAll('.cr-pill').forEach(function(b){
      var oi=+b.dataset.oi;b.classList.toggle('cr-pill-on',fSel[oi]===b.dataset.val);
      var has=fVariants.some(function(v){return v.available&&v.options[oi]===b.dataset.val;});
      b.classList.toggle('cr-pill-na',!has);
    });
    if(fCur){
      if(fprice)fprice.textContent=money(fCur.price);
      if(fatc){fatc.disabled=!fCur.available;fatcT.textContent=fCur.available?ATC_TXT:'Sold out';}
      if(fCur.featured_image&&fCur.featured_image.src&&fSel.length>1){
        if(fFront)fFront.src=fCur.featured_image.src;
      }
    }else if(fatc){fatc.disabled=true;fatcT.textContent='Unavailable';}
  }

  function openFocus(it){
    if(!focus||!fstage)return;
    curFocus=it;curView='front';
    fstage.classList.remove('cr-show-back');
    var fi=it.querySelector('.cr-view[data-pos="1"] img')||it.querySelector('.cr-view[data-pos="0"] img');
    var bi=it.querySelector('.cr-view[data-pos="-1"] img');
    if(fFront){fFront.src=fi?big(fi.currentSrc||fi.src):'';fFront.alt=it.dataset.name||'';}
    if(fBack){if(bi){fBack.src=big(bi.currentSrc||bi.src);}else{fBack.removeAttribute('src');}}
    var name=it.dataset.name||'';
    if(fname)fname.textContent=name;
    if(ffoot)ffoot.textContent=name;
    if(fbtn)fbtn.href=it.dataset.url||'#';
    if(fcount)fcount.textContent=pad(items.indexOf(it)+1)+' / '+pad(items.length);
    if(fprice)fprice.textContent=it.dataset.price||'';
    var backTab=ftabs?ftabs.querySelector('[data-cr-tab="back"]'):null;
    if(backTab)backTab.style.display=it.dataset.hasBack?'':'none';
    if(ftabs)ftabs.querySelectorAll('.cr-tab').forEach(function(b){b.classList.toggle('cr-tab-on',b.dataset.crTab==='front');});
    if(ftabs)ftabs.style.display=it.dataset.hasBack?'':'none';

    /* options + variants */
    fVariants=[];fSel=[];fCur=null;
    try{fVariants=JSON.parse(it.dataset.variants||'[]');}catch(e){}
    var names=(it.dataset.opts||'').split('|').filter(Boolean);
    if(fopts){
      fopts.innerHTML='';
      var first=fVariants.filter(function(v){return v.available;})[0]||fVariants[0];
      if(first)fSel=first.options.slice();
      names.forEach(function(nm,oi){
        var vals=[];fVariants.forEach(function(v){if(vals.indexOf(v.options[oi])<0)vals.push(v.options[oi]);});
        if(!/^(size|sizes|taille|talla|größe|groesse|maat)$/i.test(String(nm).trim()))return; /* only Size option is shown */
        var g=document.createElement('div');g.className='cr-opt-group';
        var h='<p class="cr-opt-label">'+esc(nm)+'</p><div class="cr-opt-pills">';
        vals.forEach(function(val){h+='<button type="button" class="cr-pill" data-oi="'+oi+'" data-val="'+esc(val)+'">'+esc(val)+'</button>';});
        g.innerHTML=h+'</div>';fopts.appendChild(g);
      });
    }
    if(fatc){fatc.style.display=fVariants.length?'':'none';}
    if(fVariants.length)applyVariant();

    focus.classList.add('cr-open');
    document.body.style.overflow='hidden';
    requestAnimationFrame(function(){focus.classList.add('cr-in');moveInd();});
  }
  function stepFocus(d){
    if(!curFocus)return;
    var i=(items.indexOf(curFocus)+d+items.length)%items.length;
    fstage.style.transition='none';fstage.style.opacity='0';
    openFocus(items[i]);
    requestAnimationFrame(function(){fstage.style.transition='';fstage.style.opacity='';});
  }
  if(fprev)fprev.addEventListener('click',function(){stepFocus(-1);});
  if(fnext)fnext.addEventListener('click',function(){stepFocus(1);});
  document.addEventListener('keydown',function(e){
    if(!curFocus)return;
    if(e.key==='ArrowRight')stepFocus(1);
    if(e.key==='ArrowLeft')stepFocus(-1);
  });
  window.addEventListener('resize',moveInd);

  function closeFocus(){
    if(!focus)return;
    focus.classList.remove('cr-in');
    setTimeout(function(){focus.classList.remove('cr-open');document.body.style.overflow='';curFocus=null;},380);
  }

  if(fopts){
    fopts.addEventListener('click',function(e){
      var b=e.target.closest('.cr-pill');if(!b)return;
      var oi=+b.dataset.oi,val=b.dataset.val;
      fSel[oi]=val;
      if(!findVariant()){
        /* other options (e.g. colour) are hidden — pick the best variant with this size */
        var best=null;
        fVariants.forEach(function(v){if(v.options[oi]!==val)return;if(!best||(!best.available&&v.available))best=v;});
        if(best)fSel=best.options.slice();
      }
      applyVariant();
    });
  }
  if(fatc){
    fatc.addEventListener('click',function(){
      if(!fCur||!fCur.available)return;
      fatc.disabled=true;fatcT.textContent='Adding…';
      var ROOT=(window.Shopify&&Shopify.routes&&Shopify.routes.root)||'/';
      /* sections the theme uses to render cart UI (Horizon: data-section-id, Dawn: cart-drawer / cart-icon-bubble) */
      var secIds=[];
      document.querySelectorAll('cart-items-component[data-section-id], [data-cart-section-id]').forEach(function(el){
        var id=el.dataset.sectionId||el.dataset.cartSectionId;if(id&&secIds.indexOf(id)<0)secIds.push(id);
      });
      if(document.getElementById('cart-icon-bubble'))secIds.push('cart-icon-bubble');
      if(document.querySelector('cart-drawer#CartDrawer, cart-drawer'))secIds.push('cart-drawer');
      secIds=secIds.slice(0,5);
      fetch(ROOT+'cart/add.js',{
        method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json','X-Requested-With':'XMLHttpRequest'},
        body:JSON.stringify({items:[{id:fCur.id,quantity:1}],sections:secIds.join(','),sections_url:location.pathname})
      }).then(function(r){return r.json().then(function(j){if(!r.ok)throw j;return j;});}).then(function(res){
        var sections=res.sections||{};
        return fetch(ROOT+'cart.js',{headers:{'Accept':'application/json'}}).then(function(r){return r.json();}).then(function(cart){
          fatcT.textContent='Added ✓';

          /* ① Horizon theme: its cart drawer, items & bubble all listen for "cart:update" */
          document.dispatchEvent(new CustomEvent('cart:update',{bubbles:true,detail:{
            resource:cart, sourceId:'cr-'+SID,
            data:{source:'product-form-component', itemCount:cart.item_count, productId:fCur.product_id||'', sections:sections}
          }}));

          /* ② Dawn-style themes: swap rendered sections in place */
          var dawn=document.querySelector('cart-drawer');
          if(dawn&&typeof dawn.renderContents==='function'&&sections['cart-drawer']){
            try{dawn.classList.remove('is-empty');dawn.renderContents({id:fCur.id,sections:sections});}catch(_){}
          }else{
            if(sections['cart-icon-bubble']){
              var bub=document.getElementById('cart-icon-bubble');
              var tmp=new DOMParser().parseFromString(sections['cart-icon-bubble'],'text/html');
              var nb=tmp.getElementById('cart-icon-bubble')||tmp.querySelector('.shopify-section');
              if(bub&&nb)bub.innerHTML=nb.innerHTML;
            }
          }

          /* ③ generic counters as last resort */
          document.querySelectorAll('.cart-count-bubble span[aria-hidden], [data-cart-count], .cart-count, .cart-bubble__text-count').forEach(function(el){el.textContent=cart.item_count;});
          document.querySelectorAll('.cart-bubble').forEach(function(el){el.classList.toggle('visually-hidden',!cart.item_count);el.removeAttribute('hidden');});

          /* ④ close popup and open the theme's cart drawer */
          setTimeout(function(){
            closeFocus();
            var hd=document.querySelector('cart-drawer-component');
            if(hd&&typeof hd.open==='function'){try{hd.open();}catch(_){}}
            else if(dawn&&typeof dawn.open==='function'){try{dawn.open();}catch(_){}}
            fatc.disabled=false;fatcT.textContent=ATC_TXT;
          },650);
        });
      }).catch(function(err){
        fatcT.textContent=(err&&err.description)?String(err.description).slice(0,40):'Error – try again';
        setTimeout(function(){fatc.disabled=false;fatcT.textContent=ATC_TXT;},1800);
      });
    });
  }

  if(ftabs){
    ftabs.addEventListener('click',function(e){
      var btn=e.target.closest('.cr-tab');if(!btn)return;
      var v=btn.dataset.crTab;if(v===curView)return;curView=v;
      ftabs.querySelectorAll('.cr-tab').forEach(function(b){b.classList.toggle('cr-tab-on',b.dataset.crTab===v);});
      fstage.classList.toggle('cr-show-back',v==='back');
      moveInd();
    });
  }

  var lastPtr='';
  document.addEventListener('pointerdown',function(e){lastPtr=e.pointerType||'';},true);
  var tapSel=null;
  items.forEach(function(it){
    it.addEventListener('click',function(e){
      e.preventDefault();
      var isMouse=lastPtr==='mouse'||fineHover;
      if(!isMouse&&tapSel!==it){
        if(tapSel){states.get(tapSel).t=0;kick();}
        tapSel=it;states.get(it).t=1;kick();return;
      }
      tapSel=null;openFocus(it);
    });
    it.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();openFocus(it);}});
  });

  if(closeX)closeX.addEventListener('click',closeFocus);
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&curFocus)closeFocus();});
  if(focus){
    focus.addEventListener('click',function(e){
      if(e.target===focus||e.target.classList.contains('cr-focus-bd'))closeFocus();
    });
  }

  /* entrance animation */
  if(!reduceMotion&&Element.prototype.animate&&'IntersectionObserver' in window){
    sec.style.opacity='0';
    var io=new IntersectionObserver(function(en){
      if(!en[0].isIntersecting)return;io.disconnect();
      sec.style.removeProperty('opacity');
      items.forEach(function(el,i){
        var dir=i%2?-1:1;
        el.animate([
          {transform:'translateY(-75px) rotate('+(dir*5)+'deg)',opacity:0},
          {transform:'translateY(6px) rotate('+(-dir*1.5)+'deg)',opacity:1,offset:.72},
          {transform:'translateY(0) rotate(0deg)',opacity:1}
        ],{duration:600,delay:90+i*75,easing:'cubic-bezier(.25,.8,.35,1)',fill:'backwards'});
        setTimeout(function(){impulse(el,dir*28);},90+i*75+540);
      });
    },{threshold:.15});
    io.observe(sec);
  }

})();
</script>

