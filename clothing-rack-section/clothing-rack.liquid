{% comment %}
  Clothing Rack Section — wearebrand.io style
  sections/clothing-rack.liquid
{% endcomment %}

{%- assign sl_mode  = section.settings.slider_mode -%}
{%- assign sl_speed = section.settings.auto_speed | times: 1000 -%}

<section class="cr-sec" id="cr-{{ section.id }}"
  data-slider="{{ sl_mode }}"
  data-auto-speed="{{ sl_speed }}"
  style="
    --cr-bg:      {{ section.settings.bg_color }};
    --cr-txt:     {{ section.settings.text_color }};
    --cr-rod:     {{ section.settings.rod_color }};
    --cr-hng:     {{ section.settings.hanger_color }};
    --cr-tag-bg:  {{ section.settings.tag_bg_color }};
    --cr-spd:     {{ section.settings.hover_speed }}ms;
    --cr-h-desk:  {{ section.settings.rack_height_desktop }}px;
    --cr-h-mob:   {{ section.settings.rack_height_mobile }}px;
  ">

  {%- if section.settings.label_primary != blank or section.settings.label_secondary != blank -%}
  <div class="cr-railcap">
    {%- if section.settings.label_primary != blank -%}<span>{{ section.settings.label_primary }}</span>{%- endif -%}
    {%- if section.settings.label_primary != blank and section.settings.label_secondary != blank -%}<span class="cr-railcap-sep"></span>{%- endif -%}
    {%- if section.settings.label_secondary != blank -%}<span class="cr-railcap-dim">{{ section.settings.label_secondary }}</span>{%- endif -%}
  </div>
  {%- endif -%}

  <!-- Slider wrapper (arrows + stage) -->
  <div class="cr-slider-wrap">

    {%- if sl_mode == 'manual' or sl_mode == 'auto' -%}
    <button class="cr-sl-btn cr-sl-prev" id="crPrev-{{ section.id }}" aria-label="Previous">
      <svg viewBox="0 0 24 24" fill="none"><polyline points="15 18 9 12 15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    {%- endif -%}

    <div class="cr-stage" id="crStage-{{ section.id }}">
      <div class="cr-rod" aria-hidden="true">
        {%- if section.settings.rod_image != blank -%}
          <img src="{{ section.settings.rod_image | image_url: width: 2000 }}" alt="" loading="eager" class="cr-rod-img">
        {%- endif -%}
      </div>

      <div class="cr-rack" id="crRack-{{ section.id }}">
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank or block.settings.side_image != blank -%}

            {%- assign side_img  = block.settings.side_image -%}
            {%- assign front_img = block.settings.front_image | default: product.featured_image -%}
            {%- assign back_img  = block.settings.back_image -%}
            {%- assign prod_name  = product.title | default: block.settings.custom_title -%}
            {%- assign prod_url   = product.url | default: '#' -%}
            {%- assign prod_price = product.price_min | money | strip_html -%}

            {%- assign color_idx = nil -%}
            {%- if product != blank -%}
              {%- for opt in product.options -%}
                {%- assign opt_d = opt | downcase -%}
                {%- if opt_d == 'color' or opt_d == 'colour' -%}
                  {%- assign color_idx = forloop.index0 -%}{%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            {%- assign seen_colors   = '' -%}
            {%- assign color_variants = '' -%}
            {%- if color_idx != nil -%}
              {%- for variant in product.variants -%}
                {%- assign vc     = variant.options[color_idx] -%}
                {%- assign vc_key = vc | downcase | replace: ' ', '-' -%}
                {%- unless seen_colors contains vc_key -%}
                  {%- assign seen_colors    = seen_colors    | append: vc_key | append: ',' -%}
                  {%- assign color_variants = color_variants | append: variant.id | append: ':' | append: vc | append: ',' -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}

            <div class="cr-item" role="button" tabindex="0"
                 data-name="{{ prod_name | escape }}"
                 data-price="{{ prod_price }}"
                 data-url="{{ prod_url }}"
                 data-colors="{{ color_variants | remove: ' ' }}"
                 data-default-variant="{{ product.selected_or_first_available_variant.id }}"
                 {%- if product != blank %}
                 data-opts="{{ product.options | join: '|' | escape }}"
                 data-variants="{{ product.variants | json | escape }}"
                 {%- endif %}
                 {% if back_img != blank %}data-has-back="true"{% endif %}
                 {{ block.shopify_attributes }}>

              <!-- ① Small wire hook — collar se nikalta hua -->
              <svg class="cr-hook" viewBox="0 0 20 28" fill="none" aria-hidden="true">
                <!-- hook curve (top, goes over rod) -->
                <path d="M10 28 L10 14 Q10 6 14 3 Q18 1 18 5 Q18 9 14 11 Q11 12 10 14"
                      stroke="var(--cr-hng)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
              </svg>

              <!-- ② Garment (shirt image) -->
              <div class="cr-garment">
                <!-- pos 0: side view -->
                <div class="cr-view" data-pos="0" style="opacity:1;">
                  {%- if side_img != blank -%}
                    <img src="{{ side_img | image_url: width: 500 }}"
                         width="{{ side_img.width }}" height="{{ side_img.height }}"
                         alt="{{ prod_name | escape }} – side" loading="eager" decoding="async">
                  {%- elsif front_img != blank -%}
                    <img src="{{ front_img | image_url: width: 500 }}"
                         width="{{ front_img.width }}" height="{{ front_img.height }}"
                         alt="{{ prod_name | escape }} – front" loading="eager" decoding="async">
                  {%- endif -%}
                </div>
                <!-- pos 1: front view -->
                <div class="cr-view" data-pos="1" style="opacity:0;">
                  {%- if front_img != blank -%}
                    <img src="{{ front_img | image_url: width: 800 }}"
                         width="{{ front_img.width }}" height="{{ front_img.height }}"
                         alt="{{ prod_name | escape }} – front" loading="eager" decoding="async">
                  {%- endif -%}
                </div>
                <!-- pos -1: back view -->
                {%- if back_img != blank -%}
                <div class="cr-view" data-pos="-1" style="opacity:0;">
                  <img src="{{ back_img | image_url: width: 800 }}"
                       width="{{ back_img.width }}" height="{{ back_img.height }}"
                       alt="{{ prod_name | escape }} – back" decoding="async">
                </div>
                {%- endif -%}

                <!-- Price tag -->
                <div class="cr-tag" aria-hidden="true">
                  <div class="cr-tag-inner"><span class="cr-tag-face">{{ prod_price }}</span></div>
                </div>

              </div><!-- /.cr-garment -->
            </div><!-- /.cr-item -->
          {%- endif -%}
        {%- endfor -%}
      </div><!-- /.cr-rack -->
    </div><!-- /.cr-stage -->

    {%- if sl_mode == 'manual' or sl_mode == 'auto' -%}
    <button class="cr-sl-btn cr-sl-next" id="crNext-{{ section.id }}" aria-label="Next">
      <svg viewBox="0 0 24 24" fill="none"><polyline points="9 18 15 12 9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    {%- endif -%}

  </div><!-- /.cr-slider-wrap -->

  <!-- Dots (auto/manual mode) -->
  {%- if sl_mode == 'manual' or sl_mode == 'auto' -%}
  <div class="cr-dots" id="crDots-{{ section.id }}"></div>
  {%- endif -%}

  <div class="cr-caption">
    <div class="cr-cap-name" id="crCapName-{{ section.id }}">{{ section.settings.default_caption }}</div>
    {%- if section.settings.cta_text != blank and section.settings.cta_url != blank -%}
    <div class="cr-cta-wrap"><a class="cr-cta" href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a></div>
    {%- endif -%}
  </div>

</section>

<!-- ═══════════════════════════════════════════
     FOCUS OVERLAY
     ═══════════════════════════════════════════ -->
<div class="cr-focus" id="crFocus-{{ section.id }}"
     style="--cr-bg:{{ section.settings.bg_color }};--cr-txt:{{ section.settings.text_color }};--cr-hng:{{ section.settings.hanger_color }};--cr-tag-bg:{{ section.settings.tag_bg_color }};">
  <div class="cr-focus-bd"></div>
  <button class="cr-focus-x" id="crClose-{{ section.id }}" aria-label="Close">
    <span class="cr-x-label">Close</span><span class="cr-xi"></span>
  </button>
  <div class="cr-focus-body">
    <!-- LEFT: garment -->
    <div class="cr-focus-left">
      <div class="cr-focus-glow"></div>
      <div class="cr-focus-stage" id="crFstage-{{ section.id }}">
        <img class="cr-fs-img cr-fs-front" alt="">
        <img class="cr-fs-img cr-fs-back" alt="">
      </div>
      <div class="cr-focus-shadow"></div>
    </div>
    <!-- RIGHT: details -->
    <div class="cr-focus-info">
      <div class="cr-focus-top">
        <p class="cr-focus-count" id="crFcount-{{ section.id }}"></p>
        <div class="cr-focus-nav">
          <button type="button" class="cr-fnav" id="crFprev-{{ section.id }}" aria-label="Previous"><svg viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <button type="button" class="cr-fnav" id="crFnext-{{ section.id }}" aria-label="Next"><svg viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        </div>
      </div>
      <h2 class="cr-focus-name" id="crFname-{{ section.id }}"></h2>
      <p class="cr-focus-price" id="crFprice-{{ section.id }}"></p>
      <div class="cr-focus-tabs" id="crFtabs-{{ section.id }}">
        <span class="cr-tab-ind"></span>
        <button type="button" class="cr-tab cr-tab-on" data-cr-tab="front">{{ section.settings.front_label | default: 'Front' }}</button>
        <button type="button" class="cr-tab" data-cr-tab="back">{{ section.settings.back_img_label | default: 'Back' }}</button>
      </div>
      <div class="cr-focus-opts" id="crFopts-{{ section.id }}"></div>
      <button type="button" class="cr-focus-atc" id="crFatc-{{ section.id }}"><span class="cr-atc-txt">Add to cart</span><svg class="cr-atc-ic" viewBox="0 0 24 24" fill="none"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="cr-focus-foot">
        <span id="crFfootname-{{ section.id }}"></span>
        <a id="crFbtn-{{ section.id }}" href="#">View in the shop <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</div>

<style>
/* ══════════════════════════════════════════════
   CLOTHING RACK  — #cr-{{ section.id }}
   ══════════════════════════════════════════════ */
#cr-{{ section.id }} {
  background: var(--cr-bg); color: var(--cr-txt);
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  overflow-x: clip;
  font-family: var(--font-body-family, system-ui, sans-serif);
}

/* ── rail caption ── */
#cr-{{ section.id }} .cr-railcap {
  display: flex; align-items: center; justify-content: center; gap: 14px;
  font-size: 11px; letter-spacing: 2.5px; text-transform: uppercase; font-weight: 700;
  margin-bottom: 28px;
}
#cr-{{ section.id }} .cr-railcap-sep { width: 1px; height: 13px; background: currentColor; opacity: .22; }
#cr-{{ section.id }} .cr-railcap-dim { opacity: .4; }

/* ── slider wrapper ── */
#cr-{{ section.id }} .cr-slider-wrap {
  position: relative;
  display: flex; align-items: center;
}

/* ── stage (clip overflow for slider) ── */
#cr-{{ section.id }} .cr-stage {
  position: relative; flex: 1; min-width: 0;
  padding-top: 12px;
  overflow: hidden;     /* items scroll inside this */
}

/* ── rod ── */
#cr-{{ section.id }} .cr-rod {
  position: absolute; top: 14px; left: 0; right: 0;
  height: 5px; background: var(--cr-rod);
  pointer-events: none; z-index: 2;
}
#cr-{{ section.id }} .cr-rod-img {
  position: absolute; inset: 0 0 auto; width: 100%; height: 26px;
  object-fit: fill; transform: translateY(-35%);
}

/* ── rack row ── */
#cr-{{ section.id }} .cr-rack {
  --cr-h: var(--cr-h-mob);
  display: flex; align-items: flex-start; justify-content: flex-start; gap: 0;
  padding-top: 2px;
  min-height: calc(var(--cr-h) + 40px);
  /* NO overflow here — parent .cr-stage clips */
  scrollbar-width: none;
  transition: transform .42s cubic-bezier(.45,.05,.55,.95);
  will-change: transform;
}
@media (min-width: 750px) {
  #cr-{{ section.id }} .cr-rack { --cr-h: var(--cr-h-desk); }
  #cr-{{ section.id }} .cr-rack { justify-content: center; }
}

/* ── each item ── */
#cr-{{ section.id }} .cr-item {
  flex: 0 0 auto;
  width: calc(var(--cr-h) * 0.32);
  display: flex; flex-direction: column; align-items: center;
  cursor: pointer; position: relative; z-index: 1; outline: none;
  -webkit-tap-highlight-color: transparent;
  transform: rotate(var(--cr-sw, 0deg));
  transform-origin: 50% 0;
}
#cr-{{ section.id }} .cr-item.cr-live { z-index: 5; }

/* ── garment: contains hanger + shirt ── */
#cr-{{ section.id }} .cr-garment {
  position: relative;
  width: 100%; height: var(--cr-h);
}

/* ── wire hook SVG: small, sits above garment in flex column ── */
#cr-{{ section.id }} .cr-hook {
  width: 20px; height: 28px;
  flex-shrink: 0; display: block;
  margin-bottom: -3px;   /* pulls shirt up so hook merges with collar */
  position: relative; z-index: 3;
  pointer-events: none;
}
.cr-focus-stage .cr-hook {
  width: 22px; height: 30px;
  margin-bottom: -4px;
  display: block !important;
}

/* ── garment views ── */
#cr-{{ section.id }} .cr-view {
  position: absolute; inset: 0;
  display: flex; align-items: flex-start; justify-content: center;
  pointer-events: none; transform-origin: 50% 0;
}
#cr-{{ section.id }} .cr-view img {
  height: 100%; width: auto; max-width: none;
  -webkit-user-drag: none; user-select: none;
}

/* ── price tag ── */
#cr-{{ section.id }} .cr-tag {
  position: absolute; z-index: 4;
  left: 50%; top: calc(var(--cr-h) * .05);
  width: 0; height: 0;
  transform-origin: 0 0;
  transform: rotate(-20deg);
  pointer-events: none;
}
#cr-{{ section.id }} .cr-tag::before {
  content: ''; position: absolute; left: 0; top: 0;
  width: 1px; height: calc(var(--cr-h) * .09 + 6px);
  background: rgba(70,58,44,.45);
}
#cr-{{ section.id }} .cr-tag-inner {
  position: absolute; left: 0; top: calc(var(--cr-h) * .09);
  transform: translateX(-50%) rotate(12deg);
  transform-origin: 50% 0;
  transition: transform .7s cubic-bezier(.3,1.45,.45,1);
}
#cr-{{ section.id }} .cr-tag-face {
  display: flex; align-items: center; justify-content: center;
  min-width: 36px; padding: 8px 8px 5px;
  background: var(--cr-tag-bg); color: var(--cr-txt);
  border-radius: 3px 3px 4px 4px; white-space: nowrap;
  font-size: 10px; font-weight: 700; letter-spacing: .5px;
  box-shadow: 0 2px 6px rgba(0,0,0,.12); position: relative;
}
#cr-{{ section.id }} .cr-tag-face::before {
  content: ''; position: absolute; left: 50%; top: 4px;
  width: 4px; height: 4px; margin-left: -2px; border-radius: 50%;
  background: rgba(70,58,44,.3);
}

#cr-{{ section.id }} .cr-rack { cursor: grab; -webkit-user-select: none; user-select: none; }
#cr-{{ section.id }} .cr-rack.cr-grabbing, #cr-{{ section.id }} .cr-rack.cr-grabbing .cr-item { cursor: grabbing; }
#cr-{{ section.id }} .cr-rack img { -webkit-user-drag: none; pointer-events: none; }

/* ── slider arrows ── */
#cr-{{ section.id }} .cr-sl-btn {
  flex: 0 0 auto; position: relative; z-index: 10;
  width: 44px; height: 44px; border-radius: 50%;
  background: var(--cr-bg); border: 1.5px solid rgba(0,0,0,.16);
  color: var(--cr-txt); cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  margin: 0 6px;
  transition: background .2s, transform .16s, opacity .2s;
  box-shadow: 0 2px 8px rgba(0,0,0,.10);
}
#cr-{{ section.id }} .cr-sl-btn svg { width: 18px; height: 18px; }
#cr-{{ section.id }} .cr-sl-btn:hover { background: var(--cr-txt); color: var(--cr-bg); transform: scale(1.07); }
#cr-{{ section.id }} .cr-sl-btn:disabled { opacity: .3; cursor: default; transform: none; }

/* ── dots ── */
#cr-{{ section.id }} .cr-dots {
  display: flex; justify-content: center; gap: 7px; margin-top: 16px;
}
#cr-{{ section.id }} .cr-dot {
  width: 7px; height: 7px; border-radius: 50%;
  background: var(--cr-txt); opacity: .18; cursor: pointer;
  transition: opacity .22s, transform .22s;
  border: none; padding: 0;
}
#cr-{{ section.id }} .cr-dot.cr-dot-on { opacity: 1; transform: scale(1.3); }

/* ── caption ── */
#cr-{{ section.id }} .cr-caption { text-align: center; margin-top: 20px; }
#cr-{{ section.id }} .cr-cap-name {
  font-size: 14px; font-weight: 500; min-height: 20px;
  transition: opacity .16s;
}
#cr-{{ section.id }} .cr-cap-name.cr-swap { opacity: 0; }
#cr-{{ section.id }} .cr-cta-wrap { margin-top: 16px; }
#cr-{{ section.id }} .cr-cta {
  display: inline-block; text-decoration: none;
  padding: 11px 28px; border-radius: 30px;
  background: var(--cr-txt); color: var(--cr-bg);
  font-size: 13px; font-weight: 500; letter-spacing: .5px;
  transition: opacity .2s, transform .2s;
}
#cr-{{ section.id }} .cr-cta:hover { opacity: .88; transform: translateY(-1px); }

/* ══════════════════════════════════════════════
   FOCUS OVERLAY
   ══════════════════════════════════════════════ */
.cr-focus {
  position: fixed; inset: 0; z-index: 99999;
  display: none; color: var(--cr-txt);
}
.cr-focus.cr-open { display: block; }

.cr-focus-bd {
  position: fixed; inset: 0;
  background: radial-gradient(120% 90% at 30% 50%, rgba(255,255,255,.97) 0%, rgba(248,246,242,.96) 60%, rgba(240,237,231,.97) 100%);
  -webkit-backdrop-filter: blur(30px) saturate(1.1); backdrop-filter: blur(30px) saturate(1.1);
  opacity: 0; transition: opacity .45s ease;
}
.cr-focus.cr-in .cr-focus-bd { opacity: 1; }

.cr-focus-x {
  position: fixed; top: 26px; right: 36px; z-index: 10;
  display: flex; align-items: center; gap: 10px;
  background: rgba(255,255,255,.7); border: 1px solid rgba(0,0,0,.08);
  border-radius: 40px; padding: 8px 14px 8px 18px; cursor: pointer;
  color: #1d1c1a; font: inherit; font-size: 12px; letter-spacing: .16em; text-transform: uppercase;
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  opacity: 0; transform: translateY(-6px);
  transition: opacity .3s .2s, transform .3s .2s, background .2s, color .2s;
}
.cr-focus.cr-in .cr-focus-x { opacity: 1; transform: none; }
.cr-focus-x:hover { background: #1d1c1a; color: #fff; }
.cr-focus-x:hover .cr-xi { transform: rotate(90deg); }
.cr-focus-x:hover .cr-xi::before, .cr-focus-x:hover .cr-xi::after { background: #fff; }
.cr-xi { position: relative; display: block; width: 14px; height: 14px; transition: transform .35s cubic-bezier(.3,1.4,.5,1); }
.cr-xi::before, .cr-xi::after {
  content: ''; position: absolute; left: 50%; top: 50%;
  width: 15px; height: 1.6px; background: #1d1c1a; border-radius: 2px; transition: background .2s;
}
.cr-xi::before { transform: translate(-50%,-50%) rotate(45deg); }
.cr-xi::after  { transform: translate(-50%,-50%) rotate(-45deg); }

.cr-focus-body {
  position: relative; z-index: 2;
  width: 100%; height: 100vh; height: 100dvh; max-width: 1360px; margin: 0 auto;
  display: grid; grid-template-columns: 1.15fr 1fr; align-items: center;
  column-gap: 5vw; padding: 60px 6vw 40px; box-sizing: border-box; overflow-y: auto;
}

/* ── LEFT: garment, always centered, never moves ── */
.cr-focus-left {
  position: relative; height: 100%; min-height: 0;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.cr-focus-glow {
  position: absolute; left: 50%; top: 50%; width: 78%; aspect-ratio: 1;
  transform: translate(-50%,-50%); border-radius: 50%;
  background: radial-gradient(circle, rgba(0,0,0,.055) 0%, rgba(0,0,0,0) 65%);
  pointer-events: none;
}
.cr-focus-stage {
  --fh: min(72vh, {{ section.settings.focus_height }}px);
  position: relative; width: 100%; height: var(--fh); flex: 0 0 auto;
  -webkit-user-select: none; user-select: none;
  opacity: 0; transform: translateY(-18px) rotate(-1.5deg); transform-origin: 50% 0;
  transition: opacity .5s .1s, transform .9s .1s cubic-bezier(.2,1.25,.35,1);
}
.cr-focus.cr-in .cr-focus-stage { opacity: 1; transform: none; }
.cr-fs-rod { display:none !important;
  position: absolute; left: 50%; top: -9vh; width: 3px; height: calc(9vh + 18px);
  transform: translateX(-50%); border-radius: 2px; z-index: 0;
  background: linear-gradient(90deg,#7d7d7d,#e2e2e2 45%,#8a8a8a);
}
.cr-fs-img {
  position: absolute; inset: 0; z-index: 1;
  width: 100%; height: 100%; max-width: none;
  object-fit: contain; object-position: 50% 0;
  filter: drop-shadow(0 30px 30px rgba(0,0,0,.10));
  transition: opacity .45s ease, transform .6s cubic-bezier(.22,.9,.3,1);
}
.cr-fs-img:not([src]), .cr-fs-img[src=""] { visibility: hidden; }
.cr-fs-front { opacity: 1; transform: none; }
.cr-fs-back  { opacity: 0; transform: scale(.97); }
.cr-focus-stage.cr-show-back .cr-fs-front { opacity: 0; transform: scale(.97); }
.cr-focus-stage.cr-show-back .cr-fs-back  { opacity: 1; transform: none; }
.cr-focus-shadow {
  width: 46%; height: 18px; margin-top: 10px; border-radius: 50%;
  background: radial-gradient(ellipse, rgba(0,0,0,.14), rgba(0,0,0,0) 70%);
}

/* ── RIGHT: info ── */
.cr-focus-info { width: 100%; max-width: 440px; color: #1d1c1a; text-align: left; }
.cr-focus-info > * {
  opacity: 0; transform: translateY(14px);
  transition: opacity .45s, transform .55s cubic-bezier(.22,.9,.3,1);
}
.cr-focus.cr-in .cr-focus-info > * { opacity: 1; transform: none; }
.cr-focus.cr-in .cr-focus-info > *:nth-child(1){transition-delay:.18s}
.cr-focus.cr-in .cr-focus-info > *:nth-child(2){transition-delay:.24s}
.cr-focus.cr-in .cr-focus-info > *:nth-child(3){transition-delay:.30s}
.cr-focus.cr-in .cr-focus-info > *:nth-child(4){transition-delay:.36s}
.cr-focus.cr-in .cr-focus-info > *:nth-child(5){transition-delay:.42s}
.cr-focus.cr-in .cr-focus-info > *:nth-child(6){transition-delay:.48s}
.cr-focus.cr-in .cr-focus-info > *:nth-child(7){transition-delay:.54s}

.cr-focus-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; }
.cr-focus-count { margin: 0; font-size: 11px; letter-spacing: .28em; color: #9a968f; font-variant-numeric: tabular-nums; }
.cr-focus-nav { display: flex; gap: 8px; }
.cr-fnav {
  width: 36px; height: 36px; border-radius: 50%; padding: 0; cursor: pointer;
  border: 1px solid rgba(0,0,0,.12); background: transparent; color: #1d1c1a;
  display: flex; align-items: center; justify-content: center;
  transition: background .2s, color .2s, transform .2s;
}
.cr-fnav svg { width: 15px; height: 15px; }
.cr-fnav:hover { background: #1d1c1a; color: #fff; transform: scale(1.06); }

.cr-focus-name {
  margin: 0; font-size: clamp(26px, 2.6vw, 38px); font-weight: 500;
  line-height: 1.08; letter-spacing: -.02em; color: #1d1c1a; font-family: inherit; text-transform: none;
}
.cr-focus-price { margin: 10px 0 0; font-size: 16px; font-weight: 500; color: #4a4741; font-variant-numeric: tabular-nums; }

/* segmented Front/Back */
.cr-focus-tabs {
  position: relative; display: inline-flex; margin-top: 26px; padding: 4px;
  background: rgba(0,0,0,.05); border-radius: 40px;
}
.cr-tab-ind {
  position: absolute; top: 4px; bottom: 4px; left: 4px; width: 0;
  background: #fff; border-radius: 40px; box-shadow: 0 2px 8px rgba(0,0,0,.10);
  transition: transform .4s cubic-bezier(.3,1.3,.5,1), width .4s cubic-bezier(.3,1.3,.5,1);
}
.cr-tab {
  position: relative; z-index: 1; background: transparent; border: 0; cursor: pointer;
  font: inherit; font-size: 11px; font-weight: 600; letter-spacing: .16em; text-transform: uppercase;
  color: #8f8b84; padding: 9px 22px; border-radius: 40px; transition: color .25s;
}
.cr-tab.cr-tab-on { color: #1d1c1a; }

.cr-opt-group { margin-top: 24px; }
.cr-opt-label { margin: 0 0 10px; font-size: 10px; font-weight: 600; letter-spacing: .22em; color: #9a968f; text-transform: uppercase; }
.cr-opt-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.cr-pill {
  min-width: 46px; height: 40px; padding: 0 14px; border-radius: 30px;
  border: 1px solid rgba(0,0,0,.14); background: rgba(255,255,255,.7); color: #1d1c1a;
  font: inherit; font-size: 13px; font-weight: 500; cursor: pointer;
  transition: background .2s, color .2s, border-color .2s, transform .18s;
}
.cr-pill:hover { border-color: #1d1c1a; transform: translateY(-1px); }
.cr-pill.cr-pill-on { background: #1d1c1a; color: #fff; border-color: #1d1c1a; }
.cr-pill.cr-pill-na { opacity: .35; text-decoration: line-through; }

.cr-focus-atc {
  position: relative; overflow: hidden;
  display: flex; align-items: center; justify-content: center; gap: 10px;
  width: 100%; margin-top: 26px; height: 52px;
  border: 0; border-radius: 40px; background: #1d1c1a; color: #fff;
  font: inherit; font-size: 12px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
  cursor: pointer; box-shadow: 0 10px 24px -10px rgba(0,0,0,.45);
  transition: transform .2s, box-shadow .25s, opacity .2s;
}
.cr-focus-atc::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(110deg, transparent 30%, rgba(255,255,255,.18) 50%, transparent 70%);
  transform: translateX(-100%); transition: transform .7s ease;
}
.cr-focus-atc:hover::before { transform: translateX(100%); }
.cr-focus-atc:hover { transform: translateY(-2px); box-shadow: 0 16px 30px -12px rgba(0,0,0,.5); }
.cr-atc-ic { width: 16px; height: 16px; transition: transform .3s; }
.cr-focus-atc:hover .cr-atc-ic { transform: translateX(4px); }
.cr-focus-atc:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }
.cr-focus-atc:disabled .cr-atc-ic { display: none; }

.cr-focus-foot {
  display: flex; justify-content: space-between; align-items: center;
  margin-top: 34px; padding-top: 18px; border-top: 1px solid rgba(0,0,0,.09);
  font-size: 13px; color: #6b675f;
}
.cr-focus-foot a {
  color: #1d1c1a; text-decoration: none; font-weight: 500;
  background: linear-gradient(currentColor,currentColor) 0 100%/0 1px no-repeat;
  transition: background-size .3s; padding-bottom: 2px;
}
.cr-focus-foot a:hover { background-size: 100% 1px; }

/* ── Responsive ── */
@media (max-width: 749px) {
  #cr-{{ section.id }} .cr-sl-btn { width: 36px; height: 36px; margin: 0 3px; }
  .cr-focus-x { top: 12px; right: 12px; padding: 7px 12px 7px 14px; font-size: 10px; }
  .cr-focus-body {
    grid-template-columns: 1fr; row-gap: 22px; align-content: start; align-items: start;
    padding: 70px 20px 32px;
  }
  .cr-focus-left { height: auto; }
  .cr-focus-stage { --fh: min(46vh, 420px); }
  .cr-fs-rod { top: -40px; height: 58px; }
  .cr-focus-info { max-width: none; }
  .cr-focus-name { font-size: 24px; }
  .cr-focus-tabs { margin-top: 18px; }
  .cr-focus-atc { height: 48px; }
  .cr-focus-foot { margin-top: 24px; }
}
@media (prefers-reduced-motion: reduce) {
  .cr-focus-bd, .cr-focus-stage, .cr-focus-info > *, .cr-fs-img { transition-duration: .01ms !important; }
}
</style>
<style>
