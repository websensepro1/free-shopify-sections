<section id="ks-{{ section.id }}" class="{{ root_class }}" aria-roledescription="carousel" aria-label="{{ section.settings.brand_text | escape }}">

  <div class="ks__glow" aria-hidden="true">
    <div class="ks__blob ks__blob--a" data-blob-a></div>
    <div class="ks__blob ks__blob--b" data-blob-b></div>
  </div>
  {%- if section.settings.grain_opacity > 0 -%}<div class="ks__grain" aria-hidden="true"></div>{%- endif -%}

  <div class="ks__card" data-card>
    <div class="ks__tint" aria-hidden="true"><i class="ks__tint-blob ks__tint-blob--a" data-tint-a></i><i class="ks__tint-blob ks__tint-blob--b" data-tint-b></i></div>

    <header class="ks__nav" {% unless show_nav %}hidden{% endunless %}>
      {%- if section.settings.show_logo -%}
        <a class="ks__logo" href="{{ routes.root_url }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: loading: 'eager', alt: section.settings.brand_text }}
          {%- else -%}
            {{ section.settings.brand_text }}
          {%- endif -%}
        </a>
      {%- endif -%}
    </header>

    <div class="ks__left">
      <p class="ks__brand" data-anim data-brand></p>
      <h2 class="ks__title" data-anim data-title></h2>
      <p class="ks__sub" data-anim data-sub></p>
      <div class="ks__thumbs" data-anim data-thumbs></div>
    </div>

    <div class="ks__stage" data-stage>
      <div class="ks__shadow" data-shadow></div>
    </div>

    <div class="ks__right">
      <div data-anim data-vanim data-sizes-wrap>
        <p class="ks__label">{{ section.settings.size_label }}</p>
        <div class="ks__sizes" data-sizes role="radiogroup" aria-label="{{ section.settings.size_label | escape }}"></div>
      </div>
      <div class="ks__rating" data-anim data-rating></div>
      <div class="ks__price-wrap" data-anim data-vanim data-price-wrap>
        <p class="ks__price" data-price></p>
        <span class="ks__was" data-was></span>
      </div>
      <div data-anim data-swatches-wrap>
        <p class="ks__label">{{ section.settings.color_label }}</p>
        <div class="ks__swatches" data-swatches role="radiogroup" aria-label="{{ section.settings.color_label | escape }}"></div>
        {%- if section.settings.show_color_name -%}<p class="ks__color-name" data-color-name></p>{%- endif -%}
      </div>
    </div>

    <footer class="ks__bar">
      <button type="button" class="ks__play" data-play hidden>
        <span class="ks__play-ico"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8z"/></svg></span>
        <span>{{ section.settings.play_text }}</span>
      </button>

      <div class="ks__scrub" data-scrub {% unless section.settings.show_scrubber %}hidden{% endunless %}>
        <button type="button" class="ks__arrow" data-prev aria-label="Previous">←</button>
        <span data-cur>01</span>
        <span class="ks__track"><span class="ks__fill" data-fill></span></span>
        <span data-total>03</span>
        <button type="button" class="ks__arrow" data-next aria-label="Next">→</button>
      </div>

      <button type="button" class="ks__atc" data-atc>
        <span class="ks__atc-ring" aria-hidden="true"></span>
        <span class="ks__atc-ico" aria-hidden="true">
          <svg class="ks__atc-cart" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h3l2.4 11.2a1.6 1.6 0 0 0 1.6 1.3h8.1a1.6 1.6 0 0 0 1.6-1.2L21 8H6.2"/></svg>
          <svg class="ks__atc-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 3a9 9 0 1 0 9 9" /></svg>
          <svg class="ks__atc-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 12.5l5 5 10-11"/></svg>
        </span>
        <span class="ks__atc-label" data-atc-label>{{ section.settings.atc_text }}</span>
      </button>
    </footer>
  </div>

  <div class="ks__modal" data-modal role="dialog" aria-modal="true" aria-label="Video">
    <div class="ks__modal-box" data-modal-box></div>
    <button type="button" class="ks__modal-close" data-modal-close aria-label="Close">×</button>
  </div>

  <div hidden>
    {%- for block in section.blocks -%}
      <span data-ks-block="{{ block.id }}" {{ block.shopify_attributes }}></span>
    {%- endfor -%}
  </div>

  <script type="application/json" data-ks-config>
  {
    "swatchMode": {{ section.settings.swatch_mode | json }},
    "keyboard": {{ section.settings.enable_keyboard }},
    "swipe": {{ section.settings.enable_swipe }},
    "wheel": {{ section.settings.enable_wheel }},
    "speed": {{ section.settings.anim_speed }},
    "bounce": {{ section.settings.bounce }},
    "entry": {{ section.settings.entry_from | json }},
    "idle": {{ section.settings.idle_float }},
    "floatAmount": {{ section.settings.float_amount }},
    "tilt": {{ section.settings.tilt }},
    "autoplay": {{ section.settings.autoplay }},
    "delay": {{ section.settings.autoplay_delay }},
    "maxThumbs": {{ section.settings.max_thumbs }},
    "showOos": {{ section.settings.show_sold_out_sizes }},
    "linkTitle": {{ section.settings.link_title }},
    "hoverMode": {{ section.settings.atc_hover_mode | json }},
    "hoverColor": {{ section.settings.atc_hover_color | json }},
    "afterAdd": {{ section.settings.after_add | json }},
    "cartUrl": {{ cart_link | json }},
    "show": {
      "brand": {{ section.settings.show_brand }},
      "subtitle": {{ section.settings.show_subtitle }},
      "thumbs": {{ section.settings.show_thumbs }},
      "rating": {{ section.settings.show_rating }},
      "reviewCount": {{ section.settings.show_review_count }},
      "sizes": {{ section.settings.show_sizes }},
      "swatches": {{ section.settings.show_swatches }},
      "colorName": {{ section.settings.show_color_name }},
      "price": {{ section.settings.show_price }},
      "video": {{ section.settings.show_video }}
    },
    "labels": {
      "atc": {{ section.settings.atc_text | json }},
      "added": {{ section.settings.added_text | json }},
      "soldOut": {{ section.settings.sold_out_text | json }},
      "selectProduct": {{ section.settings.empty_title | json }},
      "selectProductText": {{ section.settings.empty_text | json }}
    }
  }
  </script>

  <script type="application/json" data-ks-data>
  [
  {%- for block in section.blocks -%}
    {%- liquid
      assign p = block.settings.product

      assign hero = blank
      if block.settings.hero_override != blank
        assign hero = block.settings.hero_override | image_url: width: 1600
      endif

      assign video = block.settings.video_url
      if video == blank and p != blank
        for m in p.media
          if video == blank
            if m.media_type == 'external_video'
              if m.host == 'youtube'
                assign video = 'https://www.youtube.com/watch?v=' | append: m.external_id
              elsif m.host == 'vimeo'
                assign video = 'https://vimeo.com/' | append: m.external_id
              endif
            elsif m.media_type == 'video'
              assign mp4 = m.sources | where: 'mime_type', 'video/mp4' | first
              if mp4
                assign video = mp4.url
              endif
            endif
          endif
        endfor
      endif

      assign rating = block.settings.rating_score
      assign rating_count = 0
      assign rating_mf = p.metafields.reviews.rating.value
      if rating_mf != blank
        assign rating = rating_mf.rating | times: 5.0 | divided_by: rating_mf.scale_max
        assign rating_count = p.metafields.reviews.rating_count.value | default: 0
      endif

      assign sub = block.settings.subtitle_override
      if sub == blank and p != blank
        assign sub = p.description | strip_html | strip_newlines | truncatewords: section.settings.subtitle_words
      endif

      assign brand = block.settings.brand_override
      if brand == blank and p != blank
        assign brand = p.vendor
      endif

      assign ttl = block.settings.title_override
      if ttl == blank and p != blank
        assign ttl = p.title
      endif
    -%}
    {
      "id": {{ block.id | json }},
      "name": {{ block.settings.slide_name | json }},
      "productId": {% if p != blank %}{{ p.id }}{% else %}null{% endif %},
      "url": {% if p != blank %}{{ p.url | json }}{% else %}null{% endif %},
      "brand": {{ brand | json }},
      "title": {{ ttl | json }},
      "subtitle": {{ sub | json }},
      "hero": {{ hero | json }},
      "video": {{ video | json }},
      "rating": {{ rating | default: 0 | json }},
      "ratingCount": {{ rating_count | default: 0 | json }},
      "glow1": {{ block.settings.glow_color_1 | json }},
      "glow2": {{ block.settings.glow_color_2 | json }},
      "swatchOverride": {{ block.settings.swatch_override | json }},
      "images": [
        {%- if p != blank -%}
          {%- for img in p.images limit: 12 -%}
            {"s": {{ img | image_url: width: 200 | json }}, "l": {{ img | image_url: width: 1600 | json }}, "a": {{ img.alt | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ],
      "optionValues": [
        {%- if p != blank -%}
          {%- for opt in p.options_with_values -%}
            {"name": {{ opt.name | json }}, "values": [
              {%- for val in opt.values -%}
                {%- liquid
                  assign vname = val.name | default: val
                  assign sw_hex = nil
                  if val.swatch.color
                    assign sw_hex = val.swatch.color | color_to_hex
                  endif
                  assign sw_img = nil
                  if val.swatch.image
                    assign sw_img = val.swatch.image | image_url: width: 96
                  endif
                -%}
                {"v": {{ vname | json }}, "h": {{ sw_hex | json }}, "i": {{ sw_img | json }}}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ],
      "variants": [
        {%- if p != blank -%}
          {%- for v in p.variants limit: 100 -%}
            {%- liquid
              if section.settings.hide_zero_cents
                assign vprice = v.price | money_without_trailing_zeros | strip_html
                assign vcompare = v.compare_at_price | money_without_trailing_zeros | strip_html
              else
                assign vprice = v.price | money | strip_html
                assign vcompare = v.compare_at_price | money | strip_html
              endif
              assign vimg = nil
              if v.featured_image
                assign vimg = v.featured_image | image_url: width: 1600
              endif
            -%}
            {"id": {{ v.id }}, "t": {{ v.title | json }}, "o": [
              {%- for o in v.options -%}{{ o | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}
            ], "a": {{ v.available }}, "p": {{ vprice | json }}, "c": {% if v.compare_at_price > v.price %}{{ vcompare | json }}{% else %}null{% endif %}, "i": {{ vimg | json }}}{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        {%- endif -%}
      ]
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
  ]
  </script>

  <script>
