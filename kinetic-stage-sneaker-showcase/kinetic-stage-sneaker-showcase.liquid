      var vm = url.match(/vimeo\.com\/(?:video\/)?(\d+)/);
      var node;
      if (yt) {
        node = document.createElement('iframe');
        node.src = 'https://www.youtube-nocookie.com/embed/' + yt[1] + '?autoplay=1&rel=0';
        node.allow = 'autoplay; encrypted-media; picture-in-picture'; node.allowFullscreen = true;
      } else if (vm) {
        node = document.createElement('iframe');
        node.src = 'https://player.vimeo.com/video/' + vm[1] + '?autoplay=1';
        node.allow = 'autoplay; fullscreen; picture-in-picture'; node.allowFullscreen = true;
      } else {
        node = document.createElement('video');
        node.src = url; node.controls = true; node.autoplay = true; node.playsInline = true;
      }
