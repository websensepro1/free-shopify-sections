        var now = Date.now(), dir = e.deltaY > 0 ? 1 : -1;
        var atEdge = (dir > 0 && index === slides.length - 1) || (dir < 0 && index === 0);
        if (atEdge && now >= wheelLock) return; // let the page scroll normally at the ends
        e.preventDefault();
        if (now < wheelLock) return;
        if (now - lastW > 250) acc = 0;
        lastW = now; acc += e.deltaY;
        if (Math.abs(acc) < 30) return;
        acc = 0; wheelLock = now + 1100;
        if (dir > 0) nextSlide(); else prevSlide();
      }, { passive: false });
    }

    /* ---------- Video modal ---------- */
    function openModal() {
      var url = slides[index].video; if (!url) return;
      el.modalBox.textContent = '';
