    el.play.addEventListener('click', openModal);
    el.modalClose.addEventListener('click', closeModal);
    el.modal.addEventListener('click', function (e) { if (e.target === el.modal) closeModal(); });

    /* ---------- Cart ---------- */
    var adding = false, resetTimer = null;
    function setLabel(txt) {
      el.atcLabel.textContent = txt;
      el.atcLabel.classList.remove('is-roll'); void el.atcLabel.offsetWidth; el.atcLabel.classList.add('is-roll');
    }
    function setAtcState(state, msg, hold) {
