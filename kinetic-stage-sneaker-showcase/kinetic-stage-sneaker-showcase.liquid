      n.style.left = (e.clientX - r.left - d / 2) + 'px'; n.style.top = (e.clientY - r.top - d / 2) + 'px';
      el.atc.appendChild(n); setTimeout(function () { n.remove(); }, 650);
    }
    el.atc.addEventListener('pointerdown', ripple);

    function cartSectionIds() {
      var ids = [];
      Array.prototype.forEach.call(document.querySelectorAll('cart-items-component[data-section-id]'), function (n) {
        var id = n.getAttribute('data-section-id'); if (id && ids.indexOf(id) < 0) ids.push(id);
      });
      return ids;
    }
    function notifyTheme(s, v, added) {
      return fetch(CART_JSON, { headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (c) {
          var detail = {
            resource: added || {}, sourceId: root.id,
            data: { source: 'kinetic-stage-sneaker-showcase', itemCount: c.item_count, productId: String(s.productId), variantId: String(v.id), sections: (added && added.sections) || {} }
          };
          document.dispatchEvent(new CustomEvent('cart:update', { bubbles: true, detail: detail }));
          ['cart:refresh', 'cart:updated'].forEach(function (n) { document.dispatchEvent(new CustomEvent(n, { bubbles: true, detail: detail })); });
          if (cfg.afterAdd === 'drawer') {
            setTimeout(function () {
              var d = document.querySelector('cart-drawer-component');
              if (d && typeof d.open === 'function') d.open();
            }, 350);
          }
        })
        .catch(function () {});
    }
    el.atc.addEventListener('click', function () {
      if (adding) return;
      var s = slides[index], v = pickVariant(index);
      if (s.productId && v) {
        if (!v.a) { setAtcState('error', cfg.labels.soldOut, 1400); return; }
        adding = true; setAtcState('loading', null);
        var body = { items: [{ id: v.id, quantity: 1 }] };
        var ids = cartSectionIds(); if (ids.length) body.sections = ids.join(',');
        fetch(CART_ADD, {
          method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(body)
