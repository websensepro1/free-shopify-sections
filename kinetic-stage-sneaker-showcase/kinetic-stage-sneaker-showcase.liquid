      var L = lum(hex);
      if (L < .06) return ['#1a1a1e', '#4a4a52'];
      if (L > .78) return ['#868c96', '#d9dce1'];
      return [mix(hex, '#000000', .26), mix(hex, '#ffffff', .2)];
    }
