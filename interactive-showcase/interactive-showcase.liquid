      "unit": "px",
      "label": "Maximum Width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    },
    {
      "type": "header",
      "content": "Color Customization"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading & Label Color",
      "default": "#262626"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Description Color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "pill_bg",
      "label": "Tabs Bar Background",
      "default": "#e6f1ea"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active Timer Ring Color",
      "default": "#4b9a6a"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button Background Color",
      "default": "#559f71"
    },
    {
      "type": "color",
